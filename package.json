{
  "name": "sleepfactor",
  "version": "1.328.5",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "APP_VARIANT=development expo start --dev-client",
    "start:dev-client-tunnel": "APP_VARIANT=development expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "backfill:caffeine-amounts": "node scripts/backfill-caffeine-consumption-amounts.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
