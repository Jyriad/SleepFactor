# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# The .env.local file is already in .gitignore and will not be committed

EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Native Google Sign-In (required for Continue with Google on iPhone/Android app builds)
# In Google Cloud create: Web application + iOS (+ Android entries with package + SHA-1).
# Only Web + iOS client IDs belong in this file — Android client IDs are console-only.
# See docs/NATIVE_LOGIN_SETUP.txt for step-by-step instructions.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# iOS: set BOTH — the app picks dev vs prod from the installed app’s bundle ID / package.
# No more swapping one line when you switch between SleepFactor Dev and production builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_DEV=your_ios_client_for_com.sleepfactor.app.dev.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID_PROD=your_ios_client_for_com.sleepfactor.app.apps.googleusercontent.com

# Optional: single iOS ID (legacy). Used only if the matching DEV or PROD line above is empty.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Example format:
# EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
